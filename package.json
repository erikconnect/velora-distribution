{
  "name": "@veloracss.io/css",
  "version": "0.9.0",
  "description": "Declarative CSS motion engine (host-agnostic) with optional Velora theme skin",
  "license": "ISC",
  "unpkg": "./dist/motion-core.min.css",
  "jsdelivr": "./dist/motion-core.min.css",
  "main": "./src/velora.css",
  "exports": {
    ".": "./src/velora.css",
    "./base": "./src/base.css",
    "./motion-core": "./src/motion-core.css",
    "./motion-extended": "./src/motion-extended.css",
    "./theme": "./src/theme.css",
    "./components-core": "./src/components-core.css",
    "./transitions": "./src/transitions.css",
    "./premium": "./src/premium.css",
    "./overrides": "./src/overrides.css",
    "./full": "./src/velora.css",
    "./motion-core.min": "./dist/motion-core.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/motion-core.min.css"
  ],
  "scripts": {
    "build:min": "node scripts/build-min.mjs",
    "check:min": "node scripts/build-min.mjs --check",
    "verify": "node verify.mjs && node consumer-test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "homepage": "https://veloracss.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/erikconnect/velora-distribution.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/erikconnect/velora-distribution/issues"
  }
}
